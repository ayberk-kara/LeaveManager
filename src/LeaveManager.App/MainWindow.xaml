<Window x:Class="LeaveManager.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LeaveManager.App"
        mc:Ignorable="d"
        Title="LeaveManager"
        Width="1280"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        Icon="Assets/logo.ico">

    <Window.Resources>

        <local:LeaveDayHighlightConverter x:Key="LeaveDayHighlightConverter" />

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3E6EA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF"/>

        <!-- Card -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        

        <!-- TextBox -->
        <Style x:Key="SmoothTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FAFAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Employee item -->
        <Style x:Key="EmployeeListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F7F9"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendar base style -->
        <Style x:Key="CalendarBaseStyle" TargetType="Calendar">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Highlight leave days (the ONLY visual indicator we keep) -->
        <Style x:Key="LeaveDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Bd"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent"
                        Padding="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>

                            <!-- ✅ Today highlight kaldırıldı (hiç işaretleme yok) -->

                            <!-- Keep click selection subtle -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>

                            <!-- ✅ Leave days highlight -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource LeaveDayHighlightConverter}">
                                        <!-- Calendar day itself (DateTime) -->
                                        <Binding />
                                        <!-- ✅ ViewModel property (DataContext üzerinden) -->
                                        <Binding ElementName="RootWindow" Path="DataContext.SelectedEmployeeLeaveDays"/>


                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="CalendarDayButton" BasedOn="{StaticResource LeaveDayButtonStyle}"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Personeller"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Yeni Personel"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40"
                            MinWidth="120"
                            Padding="20,0"
                            Click="NewEmployee_Click"/>
                        </Grid>
                <TextBlock Grid.Row="2"
                           Text="Arama"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"/>

                <TextBox Grid.Row="2"
                         Margin="0,18,0,0"
                         Style="{StaticResource SmoothTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Ad veya kod ile arayın"/>

                <ListBox Grid.Row="4"
         Margin="0,10,0,0"
         ItemsSource="{Binding Employees}"
         SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
         Background="Transparent"
         BorderThickness="0">

                    <!-- Item Style + Right Click Menu -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                                BasedOn="{StaticResource EmployeeListBoxItemStyle}" />
                    </ListBox.ItemContainerStyle>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Personeli Yönet"
                             Click="ManageEmployee_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <!-- Görsel Şablon -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="#EEF2FF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                                    <TextBlock Text="{Binding Initials}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                                </Border>

                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding FullName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>

                                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Takvim"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding HeaderHintText}"
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="◀"
                                Width="44"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#F3F4F6"
                                Foreground="{StaticResource TextPrimary}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Cursor="Hand"
                                Click="PrevMonth_Click"/>

                        <Button Content="Bugün"
                                Height="40"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                Background="#F3F4F6"
                                Foreground="{StaticResource TextPrimary}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Cursor="Hand"
                                Click="Today_Click"/>

                        <Button Content="▶"
                                Width="44"
                                Height="40"
                                Margin="0,0,12,0"
                                Background="#F3F4F6"
                                Foreground="{StaticResource TextPrimary}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Cursor="Hand"
                                Click="NextMonth_Click"/>

                        <Button Content="Yeni izin"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                MinWidth="170"
                                FontSize="16"
                                Padding="24,0"
                                Click="NewLeave_Click"/>
                        <Button Content="Excel'e Aktar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                MinWidth="170"
                                FontSize="16"
                                Padding="24,0"
                                Margin="12,0,0,0"
                                Click="ExportExcel_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 4 calendars -->
                <Grid Grid.Row="2">
                    <UniformGrid Rows="2" Columns="2" Margin="0">
                        <Border Margin="0,0,10,10"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Calendar x:Name="Cal1"
                                          Style="{StaticResource CalendarBaseStyle}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                            </Viewbox>
                        </Border>

                        <Border Margin="10,0,0,10"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Calendar x:Name="Cal2"
                                          Style="{StaticResource CalendarBaseStyle}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                            </Viewbox>
                        </Border>

                        <Border Margin="0,10,10,0"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Calendar x:Name="Cal3"
                                          Style="{StaticResource CalendarBaseStyle}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                            </Viewbox>
                        </Border>

                        <Border Margin="10,10,0,0"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Calendar x:Name="Cal4"
                                          Style="{StaticResource CalendarBaseStyle}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                            </Viewbox>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
