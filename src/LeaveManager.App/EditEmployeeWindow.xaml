<Window x:Class="LeaveManager.App.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Düzenle"
        Width="716"
        Height="946"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="36"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
    </Window.Resources>

    <Grid Margin="40">
        <Border Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- HEADER -->
                    <TextBlock Text="Personel Düzenle"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Personel bilgilerini ve müdür yardımcısı atamalarını güncelleyin"
                               Margin="0,8,0,30"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>

                    <!-- SICIL -->
                    <TextBlock Text="Sicil No"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtRegistryNo"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,6,0,20"
                             IsEnabled="False"/>

                    <!-- AD SOYAD -->
                    <TextBlock Text="Ad Soyad"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtName"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,6,0,20"/>

                    <!-- ROL -->
                    <TextBlock Text="Rol"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox x:Name="cmbRole"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,6,0,20"
                              SelectionChanged="RoleComboBox_SelectionChanged"/>

                    <!-- MANAGER PANEL -->
                    <StackPanel x:Name="ManagerAssistantPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Müdür Yardımcısı Seçimi"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox x:Name="cmbManagerAssistant"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,6,0,20"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"/>

                        <Button x:Name="btnManageAssignments"
                                Content="Müdür Yardımcısı Atamalarını Yönet"
                                Width="280"
                                Height="46"
                                Margin="0,20,0,30"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Click="ManageAssignments_Click"/>
                    </StackPanel>

                    <!-- LEAVE BALANCE -->
                    <TextBlock Text="Kalan yıllık izin hakkı"
                               FontSize="13"
                               Margin="0,10,0,10"
                               Foreground="{StaticResource TextSecondary}"/>
                    <Border Background="#F5F6F8"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBox x:Name="txtRemainingAnnual"
                                         Width="70" Height="36"
                                         FontSize="16"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         MaxLength="2"
                                         Background="White"
                                         BorderBrush="{StaticResource BorderBrushSoft}"/>
                                <TextBlock Text="Yıllık"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="{StaticResource BorderBrushSoft}"
                                    HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBox x:Name="txtRemainingSick"
                                         Width="70" Height="36"
                                         FontSize="16"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         MaxLength="2"
                                         Background="White"
                                         BorderBrush="{StaticResource BorderBrushSoft}"/>
                                <TextBlock Text="Raporlu"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BUTTONS -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Sil"
                                Width="110"
                                Margin="0,0,12,0"
                                Style="{StaticResource DangerButton}"
                                Click="Delete_Click"/>
                        <Button Content="İptal"
                                Width="120"
                                Margin="0,0,12,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="Cancel_Click"/>
                        <Button Content="İzinleri Yönet"
                                Width="140"
                                Margin="0,0,12,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="ManageLeaves_Click"/>
                        <Button Content="Kaydet"
                                Width="140"
                                Style="{StaticResource PrimaryButton}"
                                Click="Save_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>