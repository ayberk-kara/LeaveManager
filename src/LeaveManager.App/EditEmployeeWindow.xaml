<Window x:Class="LeaveManager.App.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çalışan Düzenle"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35.96"/>
            <RowDefinition Height="Auto" MinHeight="39.96"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ad Soyad" Margin="0,0,0,10" Grid.RowSpan="2"/>
        <TextBox x:Name="txtName"
                 Grid.Row="2" Margin="0,0,0,10" Grid.RowSpan="2"/>

        <TextBlock Text="Sicil No"
                   Grid.Row="4" Margin="0,0,0,20" Grid.RowSpan="2"/>
        <TextBox x:Name="txtRegistryNo"
                 Grid.Row="6" Margin="0,5,0,5"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0" Width="190">
            <Button Content="Kaydet"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Save_Click"/>
            <Button Content="İptal"
                    Width="90"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>