<Window x:Class="LeaveManager.App.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Düzenle"
        Width="560"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="36"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FAFAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#FAFAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="40">

        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Personel Düzenle"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Personel bilgilerini güncelleyin"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <!-- Sicil No -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Sicil No"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtRegistryNo"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,6,0,0"
                             IsEnabled="False"/>
                </StackPanel>

                <!-- Ad Soyad -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Ad Soyad"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtName"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Rol -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="Rol"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox x:Name="cmbRole"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Buttons -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Sil"
                            Grid.Column="0"
                            Width="110"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click"/>

                    <Button Content="İptal"
                            Grid.Column="3"
                            Width="120"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>

                    <Button Content="Kaydet"
                            Grid.Column="5"
                            Width="140"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>