<Window x:Class="LeaveManager.App.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Personel"
        Width="460"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3E6EA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Yeni Personel Ekle"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Personel bilgilerini girin"
                           Margin="0,6,0,24"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>

                <!-- Sicil -->
                <TextBlock Text="Sicil No"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>

                <TextBox x:Name="SicilTextBox"
                         Height="40"
                         Margin="0,6,0,16"
                         Padding="10"/>

                <!-- Ad Soyad -->
                <TextBlock Text="Ad Soyad"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>

                <TextBox x:Name="NameTextBox"
                         Height="40"
                         Margin="0,6,0,16"
                         Padding="10"/>

                <!-- Rol -->
                <TextBlock Text="Rol"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>

                <ComboBox x:Name="RoleComboBox"
                          Height="40"
                          Margin="0,6,0,16"
                          SelectionChanged="RoleComboBox_SelectionChanged">
                    <ComboBoxItem Content="Müdür Yardımcısı"/>
                    <ComboBoxItem Content="Personel"/>

                </ComboBox>

                <!-- Bağlı Müdür Yardımcısı (Başta gizli) -->
                <StackPanel x:Name="ManagerAssistantPanel"
                            Visibility="Collapsed">

                    <TextBlock Text="Bağlı Müdür Yardımcısı"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>

                    <ComboBox x:Name="ManagerAssistantComboBox"
                              Height="40"
                              Margin="0,6,0,16">

                        <!-- Şimdilik dummy data -->
                        <ComboBoxItem Content="Ahmet Yılmaz"/>
                        <ComboBoxItem Content="Mehmet Kaya"/>

                    </ComboBox>

                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="İptal"
                            Width="100"
                            Click="Cancel_Click"/>

                    <Button Content="Kaydet"
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Window>