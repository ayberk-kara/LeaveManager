<Window x:Class="LeaveManager.App.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Personel"
        Width="460"
        MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3E6EA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FORM -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Yeni Personel Ekle"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Personel bilgilerini girin"
                               Margin="0,6,0,24"
                               FontSize="13"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Sicil No"/>
                        <TextBox x:Name="SicilTextBox"
                             Height="40"
                             Margin="0,6,0,16"/>

                        <TextBlock Text="Ad Soyad"/>
                        <TextBox x:Name="NameTextBox"
                             Height="40"
                             Margin="0,6,0,16"/>

                        <TextBlock Text="Rol"/>
                        <ComboBox x:Name="RoleComboBox"
                              Height="40"
                              Margin="0,6,0,16"
                              SelectionChanged="RoleComboBox_SelectionChanged">
                            <ComboBoxItem Content="Müdür Yardımcısı"/>
                            <ComboBoxItem Content="Personel"/>
                        </ComboBox>

                        <!-- MY PANEL -->
                        <StackPanel x:Name="ManagerAssistantPanel"
                                Visibility="Collapsed">

                            <TextBlock Text="Bağlı Müdür Yardımcısı"/>

                            <!-- Eski dropdown (artık gizli) -->
                            <ComboBox x:Name="ManagerAssistantComboBox"
                                  Height="40"
                                  Margin="0,6,0,6"
                                  DisplayMemberPath="FullName"
                                  Visibility="Collapsed"/>

                            <!-- Yeni bilgi mesajı -->
                            <TextBlock x:Name="ManagerAssistantInfoText"
                                   Text="Personele müdür yardımcısı ataması için personeli düzenleme menüsünü kullanınız."
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,4,0,16"
                                   Visibility="Collapsed"/>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                    <Button Content="İptal"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                    <Button Content="Kaydet"
                        Width="120"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>