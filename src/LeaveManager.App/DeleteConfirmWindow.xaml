<Window x:Class="LeaveManager.App.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420"
        Height="230">

    <Border Background="White"
            CornerRadius="18"
            Padding="30">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Personeli Sil"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Grid.Row="2"
                       Text="Bu personeli silmek istediğinize emin misiniz?"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#6B7280"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Vazgeç"
                        Height="40"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Cancel_Click"/>

                <Button Grid.Column="2"
                        Content="Sil"
                        Height="40"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>