<Window x:Class="LeaveManager.App.AddEmployeeChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Ekle"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F5F6F8"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="18"
            Padding="24"
            BorderBrush="#E3E6EA"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nasıl eklemek istiyorsunuz?"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827" Margin="58,0,-58,123" Grid.Row="2"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10,0,0">

                <Button Content="Tekli Ekle"
                        Width="140"
                        Height="44"
                        Margin="0,0,14,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Single_Click"/>

                <Button Content="Toplu Ekle"
                        Width="140"
                        Height="44"
                        Background="#F3F4F6"
                        Foreground="#111827"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Bulk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>